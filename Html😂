        /* SCROLLBAR ENGINE MAPPING */
        .global-scroll::-webkit-scrollbar { width: 8px; height: 8px; }
        .global-scroll::-webkit-scrollbar-track { background: rgba(2, 6, 23, 0.8); border-left: 1px solid rgba(51, 65, 85, 0.2); }
