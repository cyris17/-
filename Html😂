        .horizontal-scroll::-webkit-scrollbar-thumb { background: rgba(51, 65, 85, 0.6); border-radius: 10px; }
        .horizontal-scroll::-webkit-scrollbar-thumb:hover { background: var(--glow-color); }

        /* REAL-TIME MATRIX PULSE FEEDBACK SPECIFICATIONS */
        .canvas-compile-pulse { animation: matrixFlash 0.45s cubic-bezier(0.16, 1, 0.3, 1); }
        @keyframes matrixFlash {
