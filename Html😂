        /* HARDWARE-ACCELERATED MESH BACKGROUND GENERATOR */
        @keyframes dynamicMesh {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        body {
            background: linear-gradient(-135deg, #030712, #0b0f19, #020617, #1e1b4b, #0f172a, #040815);
